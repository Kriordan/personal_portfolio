{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JobwizardPrivateScreenshots",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::portfolio-wishlist-prod/j/*"
    },
    {
      "Sid": "VerifyJobwizardStoragePrivacy",
      "Effect": "Allow",
      "Action": "s3:GetBucketPublicAccessBlock",
      "Resource": "arn:aws:s3:::portfolio-wishlist-prod"
    }
  ]
}
