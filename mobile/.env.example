# Base URL of the Flask API (no trailing slash, no /api/v1 suffix).
#
# Defaults if unset:
#   iOS simulator / web:  http://127.0.0.1:5001
#   Android emulator:     http://10.0.2.2:5001
#
# Physical device: use your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5001
EXPO_PUBLIC_API_URL=
