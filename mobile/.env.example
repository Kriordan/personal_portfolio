# Base URL of the Flask API (no trailing slash, no /api/v1 suffix).
#
# Defaults if unset:
#   iOS simulator / web:  http://127.0.0.1:5001
#   Android emulator:     http://10.0.2.2:5001
#
# Physical device: use your machine's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5001
EXPO_PUBLIC_API_URL=

# Error reporting is opt-in; development and web never send events.
# Native builds need the setup and privacy checks in docs/error-monitoring.md.
EXPO_PUBLIC_SENTRY_ENABLED=0
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=preview
# Build only. Set SENTRY_AUTH_TOKEN as an EAS secret, never EXPO_PUBLIC_*.
SENTRY_ORG=
SENTRY_PROJECT=
