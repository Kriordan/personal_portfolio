{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "decode-uri-component": "file:./security-compat/decode-uri-component",
    "@expo/ui": "~57.0.20",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "zod": "file:./security-compat/zod-v3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node ../scripts/check-node-runtime.cjs && expo start",
    "android": "node ../scripts/check-node-runtime.cjs && expo run:android",
    "ios": "node ../scripts/check-node-runtime.cjs && expo run:ios",
    "web": "node ../scripts/check-node-runtime.cjs && expo start --web",
    "lint": "node ../scripts/check-node-runtime.cjs && expo lint",
    "typecheck": "node ../scripts/check-node-runtime.cjs && tsc --noEmit",
    "test": "node ../scripts/check-node-runtime.cjs && node --experimental-strip-types --test tests/*.test.mjs",
    "test:dependencies": "node ../scripts/check-node-runtime.cjs && node scripts/check-dependency-compat.cjs",
    "check:runtime": "node ../scripts/check-node-runtime.cjs"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "private": true,
  "overrides": {
    "node-forge": "1.4.2",
    "query-string@7.1.3": {
      "decode-uri-component": "$decode-uri-component"
    },
    "@expo/cli@57.0.27": {
      "zod": "$zod"
    },
    "eslint-plugin-react-hooks": {
      "zod": "4.6.7"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
