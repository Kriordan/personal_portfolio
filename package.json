  "description": "Personal portfolio",
  "main": "index.js",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "gulp": "^5.0.1",
    "gulp-sass": "^6.0.1",
    "sass": "^1.97.2"
  },
  "scripts": {
    "test": "node scripts/check-node-runtime.cjs && node --test tests/check-node-runtime.test.cjs tests/check-npm-audit.test.cjs tests/jobwizard-browserless.test.mjs && node scripts/check-browser-dependencies.cjs",
    "gulp": "node scripts/check-node-runtime.cjs && gulp",
    "sass": "node scripts/check-node-runtime.cjs && gulp sass",
    "watch": "node scripts/check-node-runtime.cjs && gulp watch",
    "dev": "node scripts/check-node-runtime.cjs && gulp",
    "test:browser": "node scripts/check-node-runtime.cjs && node tests/browser/run-security-check.cjs && node tests/browser/run-extraction-check.mjs",
    "audit:security": "node scripts/check-node-runtime.cjs && node scripts/check-npm-audit.cjs",
    "check:runtime": "node scripts/check-node-runtime.cjs"
